{
    "name": "salvatorecervone/laravel-permission-toolkit",
    "description": "Supercharge Spatie Laravel Permission with an AWS IAM-style Diagnostic Simulator, Visual Matrix, User Access Manager, Audit Trail, and Integrity Doctor.",
    "keywords": [
        "laravel",
        "laravel-package",
        "spatie",
        "spatie-permission",
        "permissions",
        "roles",
        "acl",
        "rbac",
        "simulator",
        "audit-log",
        "matrix",
        "user-manager",
        "integrity-check"
    ],
    "license": "MIT",
    "authors": [
        {
            "name": "Salvatore Cervone",
            "role": "Developer"
        }
    ],
    "require": {
        "php": "^8.2",
        "illuminate/support": "^10.0|^11.0|^12.0",
        "illuminate/database": "^10.0|^11.0|^12.0",
        "illuminate/routing": "^10.0|^11.0|^12.0",
        "illuminate/auth": "^10.0|^11.0|^12.0",
        "illuminate/view": "^10.0|^11.0|^12.0",
        "spatie/laravel-permission": "^5.0|^6.0"
    },
    "require-dev": {
        "orchestra/testbench": "^8.0|^9.0|^10.0",
        "phpunit/phpunit": "^10.0|^11.0"
    },
    "autoload": {
        "psr-4": {
            "SalvatoreCervone\\PermissionToolkit\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "SalvatoreCervone\\PermissionToolkit\\Tests\\": "tests/",
            "Workbench\\App\\": "workbench/app/",
            "Workbench\\Database\\Seeders\\": "workbench/database/seeders/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "SalvatoreCervone\\PermissionToolkit\\PermissionToolkitServiceProvider"
            ]
        }
    },
    "scripts": {
        "test": "vendor/bin/phpunit",
        "serve": [
            "Composer\\Config::disableProcessTimeout",
            "@build",
            "@php vendor/bin/testbench serve"
        ],
        "build": "@php vendor/bin/testbench workbench:build --ansi"
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
